{
  "name": "@gybra/pi-tg",
  "version": "0.2.0",
  "description": "Unofficial Telegram integration for Pi Coding Agent, with guided setup and in-terminal, per-message approval",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gybra/pi-tg.git"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "telegram",
    "mcp",
    "approval"
  ],
  "files": [
    "extensions",
    "src",
    "bridge-release.json",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
